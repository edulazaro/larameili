{
    "name": "edulazaro/larameili",
    "description": "Eloquent-style models for Meilisearch. Treat a Meilisearch index as your database: find, search (keyword or hybrid), save and delete documents through a model class, with index settings declared in code.",
    "keywords": ["laravel", "meilisearch", "search", "eloquent", "odm", "vector-search"],
    "license": "MIT",
    "authors": [
        {
            "name": "Edu Lazaro",
            "email": "edu@edulazaro.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "laravel/framework": ">=12.0",
        "meilisearch/meilisearch-php": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "EduLazaro\\Larameili\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EduLazaro\\Larameili\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EduLazaro\\Larameili\\LarameiliServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
